{
  "name": "ext-ara",
  "private": true,
  "description": "arabic subtitle extensions for hayase",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify-live": "node scripts/verify-live.ts",
    "smoke": "node scripts/smoke.ts",
    "reliability": "npm run build && node --env-file-if-exists=apikeys.env scripts/reliability.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "neostandard": "0.14.0",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
